{
  "$schema": "../../umbraco-package-schema.json",
  "name": "BaryoDev.Umbraco.ShareLike",
  "version": "0.1.0",
  "allowTelemetry": false,
  "extensions": [
    {
      "type": "dashboard",
      "alias": "BaryoDev.ShareLike.Dashboard",
      "name": "Most liked",
      "element": "/App_Plugins/BaryoDev.ShareLike/share-like-dashboard.js",
      "weight": -10,
      "meta": {
        "label": "Most liked",
        "pathname": "most-liked"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ]
    }
  ]
}
